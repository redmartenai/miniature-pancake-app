# Copy to .env. Expo reads EXPO_PUBLIC_* at bundle time: restart with `npx expo start --clear` after changes.

# The Django API. Use your computer's Wi-Fi IP (not localhost) so phones on the same network can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8010/api/v1

# Where the web app runs, so the phone app can open the web dashboard.
# EXPO_PUBLIC_WEB_URL=http://192.168.1.10:8130

# Map tiles (OpenStreetMap by default).
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Native maps in device builds only.
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=

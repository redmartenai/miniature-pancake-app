# EduFlow web — copy to .env.local and adjust. No secrets belong here: every VITE_* value is
# baked into the public JavaScript bundle.

# Base path or URL of the EduFlow API (backend repository legendary-waffle-skl).
# The backend sends no CORS headers, so the API must be same-origin with this app.
# Keep the default and let the dev proxy / production reverse proxy route /api to the backend.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server proxies /api (the backend's docker compose stack).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: resolve branding for this host instead of window.location.hostname.
# Useful in development, where the app runs on localhost (e.g. greenfield.eduflow.app).
VITE_BRANDING_HOST_OVERRIDE=
